# Maintainer: Omar Baroud
pkgname=lastengine
pkgver=0.1.0
pkgrel=1
pkgdesc="Clean-room LLM inference engine for MoE models on small GPUs (CUDA)"
arch=('x86_64')
url="https://github.com/TheSyrianDev/LastEngine"
license=('LicenseRef-PolyForm-Noncommercial-1.0.0')
depends=('gcc-libs' 'nvidia-utils')
makedepends=('cargo')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "LastEngine-$pkgver"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "LastEngine-$pkgver"
  cargo build --frozen --release
}

package() {
  cd "LastEngine-$pkgver"
  install -Dm755 target/release/lastengine "$pkgdir/usr/bin/lastengine"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
